# Public site base URL used in generated canonical links and internal links.
HOTSPOT_SITE_URL=https://example.com

# Optional GitHub token for higher GitHub Search API rate limits.
# GITHUB_TOKEN=

# Optional OpenAI-compatible editorial enhancement. Leave disabled for a fully
# rule-based run.
# HOTSPOT_LLM_ENABLED=0
# OPENAI_API_KEY=
# HOTSPOT_LLM_MODEL=gpt-4o-mini

# Optional search-engine discovery.
# BAIDU_PUSH_TOKEN=
# HOTSPOT_BAIDU_PUSH_TOKEN=

# Optional Telegram-style private notifications.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_HOME_CHANNEL=
# HOTSPOT_DAILY_DIGEST_MIN_HOUR=8
# HOTSPOT_HERMES_DIGEST_MIN_HOUR=8

# Optional feedback receiver behavior.
# HOTSPOT_FEEDBACK_NOTIFY_ENABLED=1
# HOTSPOT_FEEDBACK_TELEGRAM_BOT_TOKEN=
# HOTSPOT_FEEDBACK_TELEGRAM_CHAT_ID=
