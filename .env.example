# Public site base URL used in generated canonical links and internal links.
HOTSPOT_SITE_URL=https://example.com

# Optional GitHub token for higher GitHub Search API rate limits.
# GITHUB_TOKEN=

# Optional public repository link used in schema.org sameAs and generated docs.
# HOTSPOT_GITHUB_REPO_URL=https://github.com/YOUR_ACCOUNT/rdxw-hotspot-radar

# Optional Reddit Data API source. Leave unset until Reddit approves the API
# access request and an app is created at reddit.com/prefs/apps.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=rdxw-hotspot-radar/1.0 by u/YOUR_REDDIT_USERNAME
# REDDIT_SUBREDDITS=worldnews,news,technology,artificial,singularity,LocalLLaMA,OpenAI,MachineLearning,soccer,nba,sports,gaming,movies

# Optional OpenAI-compatible editorial enhancement. Leave disabled for a fully
# rule-based run.
# HOTSPOT_LLM_ENABLED=0
# OPENAI_API_KEY=
# HOTSPOT_LLM_MODEL=gpt-4o-mini

# Optional search-engine discovery.
# BAIDU_PUSH_TOKEN=
# HOTSPOT_BAIDU_PUSH_TOKEN=

# Optional public traffic measurement. The generated static pages include GA4
# and 51.LA only when these values are set.
# HOTSPOT_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# HOTSPOT_51LA_ID=
# HOTSPOT_51LA_CK=

# Optional Telegram-style private notifications.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_HOME_CHANNEL=
# HOTSPOT_DAILY_DIGEST_MIN_HOUR=8
# HOTSPOT_HERMES_DIGEST_MIN_HOUR=8

# Optional feedback receiver behavior.
# HOTSPOT_FEEDBACK_NOTIFY_ENABLED=1
# HOTSPOT_FEEDBACK_TELEGRAM_BOT_TOKEN=
# HOTSPOT_FEEDBACK_TELEGRAM_CHAT_ID=
